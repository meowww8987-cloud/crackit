generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
}

datasource db {
  // SQLite — works on z.ai platform (writable filesystem).
  // For Vercel/Netlify serverless, switch to PostgreSQL (see DEPLOY.md).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PartnerPair {
  id             String    @id @default(cuid())
  code           String    @unique
  userAName      String
  userBName      String?
  createdAt      DateTime  @default(now())
  userAData      String?
  userBData      String?
  userAUpdatedAt DateTime?
  userBUpdatedAt DateTime?
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model StudySync {
  id        String   @id @default(cuid())
  pairCode  String
  userName  String
  date      String
  studySec  Int      @default(0)
  streak    Int      @default(0)
  subject   String?
  testScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([pairCode, userName, date])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}
